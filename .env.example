# Copy to .env (ignored by Git). One student/private instance per deployment.
# Stable HTTPS origin with no path, query, or trailing /mcp.
PLMS_ISSUER_URL=https://plms-mcp.example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# This is a separate server connection password, NOT your POSTECH password.
PLMS_CONNECT_PASSWORD=
# Local Python installation only; Docker Compose uses its named /data volume.
# PLMS_DATA_DIR=/absolute/private/path/plms-mcp
# Login accepts PLMS_USERNAME and PLMS_PASSWORD from the process environment.
# Prefer the interactive prompt; do not keep school credentials in .env.
